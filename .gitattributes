# Line endings: LF for anything that runs on Linux (CI runner, containers, kind nodes).
# Windows checkout with core.autocrlf=true would otherwise turn *.sh into CRLF → "\r: command not found".
* text=auto
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.cmd  text eol=crlf
